# Copy this file to .env.local and replace both values with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server only: used by /api/wallet and /api/transaction. Never use a NEXT_PUBLIC_ prefix.
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Server only: used to persist monitor checks and protect the scheduled polling route.
# Never expose either value with a NEXT_PUBLIC_ prefix or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CRON_SECRET=GENERATE_A_LONG_RANDOM_SECRET
